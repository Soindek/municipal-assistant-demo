# Production environment for docker-compose.prod.yml.
# On the server: `cp .env.prod.example .env` and fill in the real values.
# The real .env is NEVER committed (see .gitignore).

# --- OpenAI (the only required secret) ---
OPENAI_API_KEY=sk-REPLACE_ME

# --- Postgres (used by the `db` container) ---
POSTGRES_USER=municipal
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_DB=municipal

# --- Backend ---
# Host is the compose service name `db`. The password MUST match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://municipal:REPLACE_WITH_A_STRONG_PASSWORD@db:5432/municipal
# Caddy proxies to backend:3000 — keep this 3000.
PORT=3000
TENANT_ID=vacratot

# --- Optional ---
# Protect POST /api/reindex with a bearer token:
# REINDEX_TOKEN=change-me
# OCR runs during ingestion (true by default); set false to skip:
# OCR_ENABLED=true
