# Másold ezt a fájlt `.env`-be, és töltsd ki az értékeket.
# A `.env` SOHA nem kerül a repóba (lásd .gitignore). Valódi kulcsot
# kizárólag ide / a környezeti változókba írj, soha kódba vagy configba.

# ─── OpenAI ───────────────────────────────────────────────────────────
# Az egyetlen kötelező titok. LLM-hez és embeddinghez is ezt használjuk.
OPENAI_API_KEY=sk-your-key-here

# ─── Adatbázis ────────────────────────────────────────────────────────
# Egyezzen a docker-compose.yml beállításaival.
DATABASE_URL=postgres://municipal:municipal@localhost:5432/municipal_assistant

# ─── Backend ──────────────────────────────────────────────────────────
PORT=3001
# Melyik tenant configot töltse be (config/tenants/<id>.ts).
TENANT_ID=vacratot
# A manual-upload adapter helyi mappája (ide rakd a teszt-PDF-eket).
UPLOADS_DIR=./data/uploads

# ─── Védett admin végpont ─────────────────────────────────────────────
# A /api/reindex végpont egyszerű bearer-token védelme.
REINDEX_TOKEN=change-me
