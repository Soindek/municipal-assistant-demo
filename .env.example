# Copy this file to `.env` and fill in the values.
# `.env` is NEVER committed to the repo (see .gitignore). Put real keys only
# here / in environment variables — never in code or in the config.

# ─── OpenAI ───────────────────────────────────────────────────────────
# The only required secret. Used for both the LLM and embeddings.
OPENAI_API_KEY=sk-your-key-here

# ─── Database ─────────────────────────────────────────────────────────
# Must match the docker-compose.yml settings.
DATABASE_URL=postgres://municipal:municipal@localhost:5432/municipal_assistant

# ─── Backend ──────────────────────────────────────────────────────────
PORT=3001
# Which tenant config to load (config/tenants/<id>.ts).
TENANT_ID=vacratot
# Local directory for the manual-upload adapter (put test PDFs here).
UPLOADS_DIR=./data/uploads

# ─── Protected admin endpoint ─────────────────────────────────────────
# Simple bearer-token protection for the /api/reindex endpoint.
REINDEX_TOKEN=change-me

# ─── OCR (scanned PDFs) ───────────────────────────────────────────────
# Scanned PDFs (no text layer) are processed with Tesseract (Hungarian) OCR
# at ingestion time. Slow; set to 'false' for a fast run (scanned documents
# then get a 'needs_ocr' status, without chunks).
OCR_ENABLED=true
# Safety upper bound: how many pages to OCR per document (0 = no limit).
OCR_MAX_PAGES=15
# Render scale before OCR (larger = more accurate, slower).
OCR_VIEWPORT_SCALE=3
